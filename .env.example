CPU_API_BASE=https://cpu-model.example.com
CPU_API_KEY=
CPU_CLASSIFY_MODEL=your-cpu-model
CPU_NER_MODEL=your-cpu-model
CPU_SUMMARY_MODEL=your-cpu-model
CPU_HARDWARE_PROVIDER=Intel Xeon or AMD EPYC (declare the observed platform)
CPU_INFERENCE_RUNTIME=Red Hat AI Inference vllm-cpu-rhel9
# Preferred multi-model configuration. Each key must be the model id returned by /v1/models.
# CPU_MODEL_ENDPOINTS_JSON={"small-cpu":{"label":"Small model · CPU","base_url":"https://cpu-small.example.com","provider":"Declared CPU","runtime":"Red Hat AI Inference"},"large-cpu":{"label":"Large model · CPU","base_url":"https://cpu-large.example.com","provider":"Declared CPU","runtime":"Red Hat AI Inference"}}
# DEFAULT_CPU_MODEL=small-cpu
INFERENCE_TLS_VERIFY=true

GPU_API_BASE=https://accelerator-model.example.com
GPU_API_KEY=
GPU_MODEL=your-accelerator-model
GPU_HARDWARE_PROVIDER=NVIDIA GPU, AMD Instinct, or Intel Gaudi (declare observed hardware)
GPU_INFERENCE_RUNTIME=Red Hat AI Inference supported accelerator runtime
# ACCELERATOR_MODEL_ENDPOINTS_JSON={"accelerator-a":{"label":"Model A · accelerator","base_url":"https://accelerator-a.example.com","provider":"Declared accelerator","runtime":"Red Hat AI Inference"}}
# DEFAULT_ACCELERATOR_MODEL=accelerator-a

SEMANTIC_ROUTER_URL=http://semantic-router:8094
MCP_GATEWAY_URL=http://mcp-gateway:8095
