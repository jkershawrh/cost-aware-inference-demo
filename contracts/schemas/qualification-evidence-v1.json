{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redhat.com/schemas/cost-aware-inference/qualification-evidence-v1.json",
  "title": "Cost-aware inference qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "qualification_id", "created_at", "completed_at",
    "warmup_runs", "measured_runs", "execution_pattern", "manifest", "summaries", "trials"
  ],
  "properties": {
    "schema_version": { "const": "qualification-evidence/v1" },
    "qualification_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "warmup_runs": { "type": "integer", "minimum": 0, "maximum": 5 },
    "measured_runs": { "type": "integer", "minimum": 1, "maximum": 30 },
    "execution_pattern": { "const": "sequential_trials_parallel_policies" },
    "manifest": {
      "type": "object",
      "required": [
        "environment", "framework_revision", "platform", "resource_profile",
        "cpu_model", "accelerator_model", "case_id", "placement_schema_version"
      ],
      "properties": {
        "environment": { "type": "object" },
        "framework_revision": { "type": "string" },
        "platform": { "type": "object" },
        "resource_profile": { "type": "object" },
        "cpu_model": { "type": "string" },
        "accelerator_model": { "type": "string" },
        "case_id": { "type": "string" },
        "placement_schema_version": { "const": "placement-evidence/v1" }
      }
    },
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "policy", "attempted_runs", "completed_runs", "passed_runs", "pass_rate_pct",
          "failure_rate_pct", "live_mcp_rate_pct", "routing_available_rate_pct", "median_execution_ms", "p95_execution_ms",
          "median_quality_pct", "minimum_quality_pct", "median_cost_per_1000_tasks_usd"
        ],
        "properties": {
          "policy": { "enum": ["cpu_only", "gpu_only", "heterogeneous"] },
          "attempted_runs": { "type": "integer", "minimum": 1 },
          "completed_runs": { "type": "integer", "minimum": 0 },
          "passed_runs": { "type": "integer", "minimum": 0 },
          "pass_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "failure_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "live_mcp_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "routing_available_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "median_execution_ms": { "type": ["number", "null"], "minimum": 0 },
          "p95_execution_ms": { "type": ["integer", "null"], "minimum": 0 },
          "median_quality_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "minimum_quality_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "median_cost_per_1000_tasks_usd": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}
